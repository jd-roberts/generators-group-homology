# Literal transcription: Roberts 2009.04069v1, Proposition 3.2, pp.8-9.
# Original printed order. No repairs or inferred substitutions.
RobertsV1Proposition32 := function(F)
    local z,u1,u2,u3,a,b1;
    z:=F.1; u1:=F.2; u2:=F.3; u3:=F.4; a:=F.5; b1:=F.6;
    return [
        z*u3*z^-1*u3^-1,
        u2*u3*u2^-1*u3^-1,
        u1*u2*u1^-1*u2^-1,
        u3*a*u3*a^-1,
        u1*a*u1*a^-1,
        z*u2*z^-1*u2^-1,
        a^4,
        u1*u3*u1^-1*u3^-1,
        z*a*z*a^-1,
        z*u1*z^-1*u1^-1,
        u2*a*u2*a^-1,
        z^7,
        b1*z^-1*b1*z*b1^-1*z^-1*b1^-1*z,
        b1*z^-2*b1*z^2*b1^-1*z^-2*b1^-1*z^2,
        z^-3*b1*z^-1*a^-1*b1*z^-1*a^-1*b1*z^3*a,
        b1*z^-3*b1*z^-2*b1^-2*z^-1*a^-1*u3*a^-1*z^-1*b1^-1*u3,
        b1*z^-1*b1^-2*z^-1*b1*a^-1*z^3*u2*a^-1*z^-2*b1^-1*u2,
        b1*z^-1*b1*z^-3*b1^-2*z^-1*u1^-1*a^-2*z^-2*b1^-1*u1,
        b1*z^-3*b1*z^3*b1^-1*z^-3*b1^-1*z^3,
        z^-1*b1^-7*z*u2^-1*z*u3^-1*u1^-1*z*b1^-1*z^-1*u1*z^-1*u2*u3,
        b1^-7*u2^-1*z*u3^-1*u1^-1*z^2*b1^-1*z^-3*u1*u2*u3,
        z^-3*b1^-7*z^-1*u2^-1*z^-2*u3^-1*u1^-1*z^-1*b1^-1*u1*u2*u3,
        z*b1^-7*u2^-1*u3^-1*u1^-1*z^3*b1^-1*z^-3*u1*z^-1*u2*u3,
        z^3*b1^-7*u2^-1*z^-2*u3^-1*u1^-1*z^-2*b1^-1*z*u1*u2*u3,
        z^2*b1*z^-3*b1*z^-3*b1*z*b1*z*b1*z^3*b1*z^-1*b1*a^-2,
        z^-3*b1*z^-1*b1^-1*u2^-1*a^-1*b1*z^-1*b1^-1*z^-3*u2^-1*a^-1*z^-3*b1*z^-1*b1^-1*z^-3*u2^-1*a^-1,
        z^-1*b1^-1*z^-2*b1*z^3*u3^-1*a^-1*z^-1*b1^-1*z^-2*b1*z^3*u3^-1*a^-1*z^-1*b1^-1*z^-2*b1*z^3*u3^-1*a^-1,
        b1^-1*z^-3*b1*z*a^-1*z^-2*u1*b1^-1*z^-3*b1*z^3*u1^-1*a^-1*b1^-1*z^-3*b1*z^3*u1^-1*a^-1,
        b1^-1*z^-1*b1*z^-2*b1*z^-1*b1^-1*a^-1*z^3*u1*u2*z^3*b1^-1*z*b1*z^2*b1*z*b1^-1*u1^-1*a^-1*u2*z^3*b1^-1*z*b1*z^2*b1*z*b1^-1*u1^-1*a^-1*u2,
        b1^-1*z^-1*b1^-1*z^-2*b1*z^-2*b1*z^-1*u1^-1*z^-1*a^-1*u3*z^-3*b1*z^2*b1^-1*z*b1^-1*z^2*b1*u1^-1*z^-2*a^-1*u3*z^-1*b1^-1*z^-2*b1*z^3*b1^-1*z^2*b1*u1^-1*z^-2*a^-1*u3,
        b1^-1*z^3*b1^-1*z^-1*b1*z^-1*b1*z*a^-1*z^-2*u3*u2*z^-3*b1*z^-1*b1^-1*z^2*b1*z*b1^-1*z*u3^-1*a^-1*u2*z^-3*b1*z^-1*b1^-1*z^2*b1*z*b1^-1*z*u3^-1*a^-1*u2*z^3,
        z*b1*z^-3*b1^-1*z^-3*b1*z*u1^-1*z*a^-1*u2*u3*z^-3*b1*z^-1*b1^-1*z^-1*b1*z^3*b1*z^2*b1^-1*z*b1^-1*z^-1*u1^-1*a^-1*u2*u3*z^-3*b1*z^-1*b1^-1*z^-1*b1*z^3*b1*z^2*b1^-1*z*b1^-1*z^-1*u1^-1*a^-1*u2*u3*b1^-1*z^2*b1*z*b1^-1
    ];
end;
RobertsV1Proposition32Map := function(F)
    local z,u1,u2,u3,a,b1;
    z:=F.1; u1:=F.2; u2:=F.3; u3:=F.4; a:=F.5; b1:=F.6;
    return [z,u1,u2,u3,a,z^-3*b1*z^3*a^-1,z^-3*b1*z^3,b1,
        z^3*b1*z^-3,z^-1*b1*z,z^2*b1*z^-2,z^-2*b1*z^2,
        z*b1*z^-1,z^-2*u1*z^-1*u2*u3];
end;
